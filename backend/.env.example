# ============================================================
# CONFIGURACIÓN DE SERVIDOR Y ENTORNO
# ============================================================
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS
# Opciones para DB_ENGINE: 'sqlite' o 'mysql'
# ============================================================
DB_ENGINE=sqlite

# Configuración SQLite
SQLITE_DB_PATH=database.db

# Configuración MySQL (usado si DB_ENGINE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=2004
DB_NAME=inventario_automotriz
